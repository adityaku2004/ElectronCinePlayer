{
  "name": "cine-media-player",
  "productName": "Cine Media Player",
  "description": "A modern VLC-inspired desktop media player built with Electron.",
  "author": "Aditya Udai <adityaudai2004@gmail.com>",
  "homepage": "https://github.com/adityaudai2004/cine-media-player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:electron:main": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-electron/main.cjs --external:electron",
    "build:electron:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-electron/preload.cjs --external:electron",
    "build:electron": "npm run build && npm run build:electron:main && npm run build:electron:preload",
    "build:linux": "npm run build:electron && electron-builder --linux deb",
    "electron": "electron dist-electron/main.cjs",
    "dist": "npm run build:electron && electron-builder",
    "dist:deb": "npm run build:electron && electron-builder --linux deb",
    "dist:appimage": "npm run build:electron && electron-builder --linux AppImage",
    "dist:linux": "npm run build:electron && electron-builder --linux deb AppImage tar.gz",
    "dist:win": "npm run build:electron && electron-builder --win nsis",
    "dist:mac": "npm run build:electron && electron-builder --mac dmg",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.cinemediaplayer.app",
    "productName": "Cine Media Player",
    "copyright": "Copyright © 2026 Cine Media Player Contributors",
    "artifactName": "${name}_${version}_${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icons",
      "category": "AudioVideo;Player;Video;",
      "syncDesktopName": true,
      "maintainer": "Aditya Udai <adityaudai2004@gmail.com>",
      "synopsis": "Next-Gen Cinematic Media Player Engine for Web & Desktop",
      "description": "A modern, high-performance, cinematic desktop media player with 10-band equalizer, audio boost, and universal subtitle engine.",
      "executableName": "cine-media-player"
    },
    "deb": {
      "packageName": "cine-media-player",
      "priority": "optional",
      "packageCategory": "video",
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "libasound2",
        "libgbm1"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
